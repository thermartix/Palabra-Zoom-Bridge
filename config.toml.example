[app]
# Use "cable" for the current virtual-cable bridge. Use "sdk-probe" to test
# Zoom Meeting SDK raw-audio capture without starting Palabra.
mode = "cable"

[translation]
source_language = "es"
target_language = "en"
voice_id = "your-voice-id"
# Experimental: clone live speaker voices after they have spoken long enough.
# When true, voice_id is ignored.
voice_cloning = false

[zoom]
# These are the devices selected inside Zoom. The bridge uses the matching
# opposite cable sides automatically.
speaker_device = "CABLE-B Input"
mic_device = "CABLE-A Output"
end_bridge_when_meeting_ends = true
meeting_title_patterns = ["Zoom Meeting", "Zoom Webinar"]
meeting_check_seconds = 2.0
meeting_end_grace_seconds = 15.0

[audio]
api_rate = 24000
channels = 1
# WASAPI is intentionally omitted: this bridge blocks it because VB-Cable endpoints have compatibility issues on some Windows systems.
hostapi_preference = ["Windows DirectSound", "MME", "Windows WDM-KS"]

[bridge]
chunk_ms = 320
input_block_ms = 50
raw_palabra_playback = false
playback_buffer_ms = 300
phrase_start_buffer_ms = 1200
playback_tempo = 1.075
playback_max_tempo = 1.15
playback_tempo_algorithm = "resample"
playback_fade_ms = 5
output_peak_limit = 0.65
startup_delay = 0.0
task_ready_timeout_seconds = 30.0
task_poll_seconds = 2.0
end_task_eos_timeout_seconds = 2.0
graceful_shutdown_timeout_seconds = 6.0
playback_drain_timeout_seconds = 30.0

[palabra]
# These segmentation settings favor complete returned audio over low latency.
# Changing them can make Palabra split or replace speech segments
# unpredictably, which may cause missing words/audio chunks.
segment_confirmation_silence_threshold = 0.7
only_confirm_by_silence = true
sentence_splitter_enabled = false
translate_partial_transcriptions = false
desired_queue_level_ms = 5000
max_queue_level_ms = 20000
auto_tempo = true
min_tempo = 1.0
max_tempo = 1.45
[diagnostics]
test_seconds = 3.0
test_volume = 0.5
record_debug_mp3 = false

[zoom_sdk]
meeting_number = ""
password = ""
display_name = "Palabra SDK Probe"
probe_seconds = 10.0
output_wav = "debug/zoom_sdk_probe.wav"
sample_rate = 48000
channels = 1
play_local = false
local_output_device = ""
# Adapter module contract:
# - run_probe(settings, audio_callback), or
# - create_adapter(settings, audio_callback).run_probe()
# audio_callback receives pcm_s16le bytes, sample_rate, channels.
adapter_module = ""
# To use the built-in process adapter, set:
# adapter_module = "modules.zoom_sdk_process_adapter"
# adapter_command = "native/ZoomSdkProbe/bin/Release/ZoomSdkProbe.exe"
# adapter_args = ["--simulate"]
# sdk_root = "C:/dev/zoom-sdk-windows"
adapter_command = ""
adapter_args = []
sdk_root = ""
dry_run = false
